{%- if section.blocks.size > 0 -%}

  {%- if section.settings.anchor_id != blank -%}
    <div id="{{ section.settings.anchor_id | handleize }}" class="section-anchor"></div>
  {%- endif -%}
  <style>
    #shopify-section-{{ section.id }} {
      --media-grid-row-height: {{ section.settings.mobile_row_height }}px;
      --media-grid-gap: {% if section.settings.spacing == 'xs' %}0.5rem{% elsif section.settings.spacing == 'sm' %}1rem{% elsif section.settings.spacing == 'md' %}1.5rem{% elsif section.settings.spacing == 'lg' %}2rem{% else %}0rem{% endif %};

      {%- if section.settings.section_width == 'full' -%}
        --container-gutter: var(--media-grid-gap);
      {%- endif -%}

      {%- if section.settings.subheading == blank and section.settings.title == blank and section.settings.content == blank and section.settings.section_width == 'full' -%}
        --section-vertical-spacing-override: var(--media-grid-gap);
      {%- endif -%}
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --media-grid-row-height: {{ section.settings.desktop_row_height }}px;
      }
    }

    @media screen and (min-width: 1150px) {
      #shopify-section-{{ section.id }} {
        --media-grid-gap: {% if section.settings.spacing == 'xs' %}0.75rem{% elsif section.settings.spacing == 'sm' %}1.25rem{% elsif section.settings.spacing == 'md' %}1.875rem{% elsif section.settings.spacing == 'lg' %}2.5rem{% else %}0rem{% endif %};
      }
    }

    @media screen and (pointer: fine) and (prefers-reduced-motion: no-preference) {
      #shopify-section-{{ section.id }} .content-over-media--has-content::before {
        transition: background 1.2s cubic-bezier(.4, .0, .2, 1);
      }

      #shopify-section-{{ section.id }} .group.content-over-media--has-content:hover::before {
        background: rgb(0 0 0 / 0.3);
      }
    }
  </style>

  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

  <div class="section-spacing color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}" {% if section.settings.allow_transparent_header %}allow-transparent-header{% endif %}>
    <div class="container {% unless section.settings.section_width == 'full' %}container--{{ section.settings.section_width }}{% endunless %}">
      <div class="section-stack">
        {%- render 'section-header', subheading: section.settings.subheading, heading: section.settings.title, content: section.settings.content -%}

        {%- liquid
          comment
            SP: Resolve metaobject gallery images list
          endcomment
          assign sp_gallery_images = nil
          if section.settings.sp_use_metaobject_gallery and metaobject != blank and metaobject.gallery_images != blank
            assign sp_gallery_images = metaobject.gallery_images.value
          endif

          comment
            SP: Masonry pattern logic
          endcomment
          assign sp_use_pattern = false
          if section.settings.sp_masonry_style != 'custom'
            assign sp_use_pattern = true
            case section.settings.sp_masonry_style
              when 'balanced'
                assign sp_pattern_cols = '6,6,6,6' | split: ','
                assign sp_pattern_rows = '2,2,2,2' | split: ','
              when 'editorial'
                assign sp_pattern_cols = '8,4,4,8' | split: ','
                assign sp_pattern_rows = '2,2,1,1' | split: ','
              when 'mosaic'
                assign sp_pattern_cols = '4,4,4,8,4,8' | split: ','
                assign sp_pattern_rows = '2,1,1,2,2,1' | split: ','
              when 'landscape_thirds'
                assign sp_pattern_cols = '6,6,12' | split: ','
                assign sp_pattern_rows = '2,2,2' | split: ','
              when 'uniform'
                assign sp_pattern_cols = '4,4,4' | split: ','
                assign sp_pattern_rows = '2,2,2' | split: ','
            endcase
          endif
        -%}

        <media-grid class="media-grid">
          {%- for block in section.blocks -%}
            {%- comment -%} SP: Resolve image — gallery by position, then block picker fallback {%- endcomment -%}
            {%- assign sp_block_image = block.settings.image -%}
            {%- if sp_gallery_images and block.type == 'image' -%}
              {%- assign sp_gallery_img = sp_gallery_images[forloop.index0] -%}
              {%- if sp_gallery_img -%}
                {%- assign sp_block_image = sp_gallery_img -%}
              {%- endif -%}
            {%- endif -%}

            {%- comment -%} SP: Masonry effective spans {%- endcomment -%}
            {%- if sp_use_pattern -%}
              {%- assign sp_idx = forloop.index0 | modulo: sp_pattern_cols.size -%}
              {%- assign effective_col = sp_pattern_cols[sp_idx] -%}
              {%- assign effective_row = sp_pattern_rows[sp_idx] -%}
            {%- else -%}
              {%- assign effective_col = block.settings.column_count -%}
              {%- assign effective_row = block.settings.row_count -%}
            {%- endif -%}

            {%- assign sp_has_hotspots = false -%}
            {%- if block.type == 'image' -%}
              {%- if block.settings.product_hotspot_1 != blank or block.settings.product_hotspot_2 != blank or block.settings.product_hotspot_3 != blank or block.settings.product_hotspot_4 != blank -%}
                {%- assign sp_has_hotspots = true -%}
              {%- endif -%}
            {%- endif -%}

            {%- assign sp_has_content = false -%}
            {%- if block.settings.title != blank or block.settings.content != blank or block.settings.link_text != blank -%}
              {%- assign sp_has_content = true -%}
            {%- endif -%}

            {%- capture block_content -%}
              <div class="content-over-media color-scheme color-scheme--{{ block.settings.color_scheme.id }} group{% if sp_has_hotspots %} sp-has-hotspots{% endif %}{% if sp_has_content %} content-over-media--has-content{% endif %}" reveal-on-scroll="true" style="--content-over-media-overlay: {{ block.settings.overlay_color.rgb }} / {{ block.settings.overlay_opacity | divided_by: 100.0 }};">
                {%- if block.type == 'image' -%}
                  {%- if sp_has_hotspots -%}<div class="sp-hotspot-image-outer"><div class="sp-hotspot-image-wrap" style="--sp-image-aspect: {{ sp_block_image.aspect_ratio }};">{%- endif -%}
                  {%- if sp_block_image -%}
                    {%- if section.settings.section_width == 'full' -%}
                      {%- capture sizes_attribute -%}(max-width: 699px) 100vw, {{ 100.0 | divided_by: 12.0 | times: effective_col | round }}vw{%- endcapture -%}
                    {%- else -%}
                      {%- capture sizes_attribute -%}(max-width: 699px) 100vw, {{ 1260.0 | divided_by: 12.0 | times: effective_col | round }}px{%- endcapture -%}
                    {%- endif -%}

                    {%- liquid
                      assign loading_strategy = nil

                      # As of today, Shopify reset the automatic loading strategy on each section group. This section is often used in the footer group
                      # to show some images on every pages. This allows to ensure that all images are always lazy-loaded when this section is used in the footer.
                      if section.location == 'footer'
                        assign loading_strategy = 'lazy'
                      endif

                      assign sp_zoom_class = 'zoom-image group-hover:zoom'
                      if section.settings.sp_enable_image_zoom == false
                        assign sp_zoom_class = ''
                      endif

                      echo sp_block_image | image_url: width: sp_block_image.width | image_tag: loading: loading_strategy, sizes: sizes_attribute, widths: '200,300,400,500,600,700,800,1000,1200,1400,1600', class: sp_zoom_class
                    -%}
                  {%- else -%}
                    {%- capture collection_image -%}collection-{% cycle '1', '2', '3', '4' %}{%- endcapture -%}
                    {%- if section.settings.sp_enable_image_zoom -%}
                      {{- collection_image | placeholder_svg_tag: 'placeholder zoom-image group-hover:zoom' -}}
                    {%- else -%}
                      {{- collection_image | placeholder_svg_tag: 'placeholder' -}}
                    {%- endif -%}
                  {%- endif -%}

                  {%- if sp_has_hotspots -%}
                    {%- for hi in (1..4) -%}
                      {%- capture prod_key -%}product_hotspot_{{ hi }}{%- endcapture -%}
                      {%- capture horiz_key -%}hotspot_{{ hi }}_horizontal{%- endcapture -%}
                      {%- capture vert_key -%}hotspot_{{ hi }}_vertical{%- endcapture -%}
                      {%- assign hs_product = block.settings[prod_key] -%}
                      {%- if hs_product != blank -%}
                        {%- capture color_key -%}hotspot_{{ hi }}_color{%- endcapture -%}
                        {%- assign hs_color = block.settings[color_key] | default: section.settings.tooltip_footer_color -%}
                        <div class="sp-hotspot-wrap" style="--sp-hotspot-top: {{ block.settings[vert_key] }}%; --sp-hotspot-left: {{ block.settings[horiz_key] }}%;">
                          <button class="sp-hotspot"
                            data-tooltip-id="sp-tooltip-{{ block.id }}-{{ hi }}"
                            aria-label="View product {{ hi }}"
                            type="button">
                          </button>
                          <div class="sp-tooltip" id="sp-tooltip-{{ block.id }}-{{ hi }}"
                               style="--sp-tooltip-footer-bg: {{ hs_color }};">
                            <div class="sp-tooltip__image">
                              {%- if hs_product.featured_image -%}
                                {{ hs_product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
                              {%- endif -%}
                            </div>
                            <div class="sp-tooltip__footer">
                              <p class="sp-tooltip__title">{{ hs_product.title }}</p>
                              <a href="{{ hs_product.url }}" class="sp-tooltip__link">Explore Product</a>
                            </div>
                          </div>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div></div>
                  {%- endif -%}

                {%- else -%}
                  {%- if block.settings.video -%}
                    {%- render 'media', media: block.settings.video, autoplay: block.settings.autoplay, loop: true, controls: block.settings.show_controls -%}
                  {%- else -%}
                    {%- capture collection_image -%}collection-{% cycle '1', '2', '3', '4' %}{%- endcapture -%}
                    {%- if section.settings.sp_enable_image_zoom -%}
                      {{- collection_image | placeholder_svg_tag: 'placeholder zoom-image group-hover:zoom' -}}
                    {%- else -%}
                      {{- collection_image | placeholder_svg_tag: 'placeholder' -}}
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}

                {%- if block.settings.title != blank or block.settings.content != blank or block.settings.link_text != blank -%}
                  <div class="prose prose--tight text-start sm:text-center {{ block.settings.mobile_text_position }} {{ block.settings.text_position }}">
                    <p class="{{ block.settings.heading_tag }} text-start sm:text-center" style="text-wrap: balance; max-inline-size: 15ch;">{{ block.settings.title }}</p>

                    {{- block.settings.content -}}

                    {%- if block.settings.link_text != blank -%}
                      <div style="display: flex;" class="justify-start sm:justify-center">
                        {%- render 'button', content: block.settings.link_text, style: block.settings.link_style -%}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endcapture -%}

            {%- comment -%}SP: Aspect ratio based on column width{%- endcomment -%}
            {%- if effective_col == '12' -%}
              {%- assign sp_aspect = '16 / 9' -%}
            {%- else -%}
              {%- assign sp_aspect = '2 / 3' -%}
            {%- endif -%}

            {%- if block.settings.link_url and sp_has_hotspots == false -%}
              <a href="{{ block.settings.link_url }}" class="media-grid__item" style="--media-grid-item-column-span: {{ effective_col }}; --media-grid-item-row-span: {{ effective_row }}; --sp-aspect: {{ sp_aspect }}" {{ block.shopify_attributes }}>
                {{- block_content -}}
              </a>
            {%- else -%}
              <div class="media-grid__item" style="--media-grid-item-column-span: {{ effective_col }}; --media-grid-item-row-span: {{ effective_row }}; --sp-aspect: {{ sp_aspect }}" {{ block.shopify_attributes }}>
                {{- block_content -}}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </media-grid>
      </div>
    </div>
  </div>
{%- endif -%}

<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    function closeAll(except) {
      section.querySelectorAll('.sp-tooltip.is-visible').forEach(function(t) {
        if (t !== except) t.classList.remove('is-visible');
      });
      section.querySelectorAll('.media-grid__item[style*="z-index"]').forEach(function(gi) {
        if (!except || !gi.contains(except)) gi.style.removeProperty('z-index');
      });
    }

    section.addEventListener('click', function(e) {
      var hotspot = e.target.closest('.sp-hotspot');
      if (hotspot) {
        e.preventDefault();
        e.stopPropagation();
        var tooltip = hotspot.nextElementSibling;
        if (!tooltip) return;

        var isOpen = tooltip.classList.contains('is-visible');
        closeAll();
        if (!isOpen) {
          tooltip.classList.add('is-visible');
          var gridItem = hotspot.closest('.media-grid__item');
          if (gridItem) gridItem.style.zIndex = '10';
        }
        return;
      }

      if (!e.target.closest('.sp-tooltip')) {
        closeAll();
      }
    }, true);

    window.addEventListener('resize', function() { closeAll(); });
  })();
</script>

{% schema %}
{
  "name": "t:sections.media_grid.name",
  "class": "shopify-section--media-grid",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "allow_transparent_header",
      "label": "t:global.section.allow_transparent_header",
      "info": "t:global.section.allow_transparent_header_info",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_row_height",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "t:sections.media_grid.desktop_row_height",
      "default": 290
    },
    {
      "type": "range",
      "id": "mobile_row_height",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "t:sections.media_grid.mobile_row_height",
      "default": 180
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:global.sizes.section_width",
      "options": [
        {
          "value": "xs",
          "label": "t:global.sizes.x_small"
        },
        {
          "value": "sm",
          "label": "t:global.sizes.small"
        },
        {
          "value": "md",
          "label": "t:global.sizes.medium"
        },
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        },
        {
          "value": "full",
          "label": "t:global.sizes.full_width"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:global.spacing.column_spacing",
      "options": [
        {
          "value": "none",
          "label": "t:global.sizes.none"
        },
        {
          "value": "xs",
          "label": "t:global.sizes.x_small"
        },
        {
          "value": "sm",
          "label": "t:global.sizes.small"
        },
        {
          "value": "md",
          "label": "t:global.sizes.medium"
        },
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        }
      ],
      "default": "md"
    },
    {
      "type": "checkbox",
      "id": "sp_enable_image_zoom",
      "label": "Enable image hover zoom",
      "default": true
    },
    {
      "type": "header",
      "content": "Gallery layout"
    },
    {
      "type": "checkbox",
      "id": "sp_use_metaobject_gallery",
      "label": "Use project gallery images",
      "info": "When enabled on a project page, each block's image is sourced from the metaobject gallery_images field by position. Block image pickers are used as fallback.",
      "default": false
    },
    {
      "type": "select",
      "id": "sp_masonry_style",
      "label": "Masonry layout pattern",
      "info": "Overrides per-block column/row settings. Set to Custom to use individual block settings.",
      "options": [
        {
          "value": "custom",
          "label": "Custom (use block settings)"
        },
        {
          "value": "balanced",
          "label": "Balanced (50/50 grid)"
        },
        {
          "value": "editorial",
          "label": "Editorial (hero + supporting)"
        },
        {
          "value": "mosaic",
          "label": "Mosaic (mixed sizes)"
        },
        {
          "value": "landscape_thirds",
          "label": "Landscape every third"
        },
        {
          "value": "uniform",
          "label": "Uniform grid"
        }
      ],
      "default": "custom"
    },
    {
      "type": "header",
      "content": "t:global.section.header_category"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Media grid"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor link ID",
      "info": "Enter a unique ID (e.g. \"our-studio\") to create a link target. Use in menu URLs as #our-studio"
    },
    {
      "type": "header",
      "content": "Hotspot tooltips"
    },
    {
      "type": "color",
      "id": "tooltip_footer_color",
      "label": "Hotspot tooltip footer colour",
      "default": "#7a8450"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.media_grid.blocks.image.name",
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:global.colors.scheme",
          "default": "scheme-4"
        },
        {
          "type": "image_picker",
