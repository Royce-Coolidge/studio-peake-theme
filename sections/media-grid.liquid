          "min": 1,
          "max": 3,
          "label": "t:sections.media_grid.blocks.image.row_count",
          "info": "t:sections.media_grid.blocks.image.row_count_info",
          "default": 2
        },
        {
          "type": "header",
          "content": "t:global.text.content"
        },
        {
