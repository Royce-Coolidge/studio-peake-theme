{%- if section.settings.anchor_id != blank -%}
  <div id="{{ section.settings.anchor_id | handleize }}" class="section-anchor"></div>
{%- endif -%}

{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }}" {% if section.settings.allow_transparent_header %}allow-transparent-header{% endif %}>
  <div class="sp-contact-layout">
    {%- comment -%}--- IMAGE PANEL ---{%- endcomment -%}
    <div class="sp-contact-layout__image">
      {%- if section.settings.mobile_image != blank -%}
        {{ section.settings.mobile_image | image_url: width: section.settings.mobile_image.width | image_tag: sizes: '100vw', widths: '400,600,800', loading: 'lazy', class: 'sp-contact-layout__image--mobile' }}
      {%- endif -%}
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: section.settings.image.width | image_tag: sizes: '(max-width: 699px) 100vw, 50vw', widths: '400,600,800,1000,1200,1400,1600', loading: 'lazy', class: 'sp-contact-layout__image--desktop' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>

    {%- comment -%}--- FORM PANEL ---{%- endcomment -%}
    <div class="sp-contact-layout__form">
      <div class="sp-contact-form">
        {%- if section.settings.heading != blank -%}
          <h2 class="h2 sp-contact-form__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- form 'contact', class: 'sp-contact-form__fields' -%}
          {%- if form.posted_successfully? -%}
            <p class="sp-contact-form__success">{{ section.settings.success_message }}</p>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="sp-contact-form__errors">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <input type="hidden" name="contact[tags]" value="contact-page">

          {%- comment -%}--- Row: First Name / Last Name ---{%- endcomment -%}
          <div class="sp-contact-form__row sp-contact-form__row--half">
            <div class="sp-contact-form__field">
              <input type="text" name="contact[first_name]" id="contact-first-name" class="sp-contact-form__input" placeholder="{{ section.settings.first_name_label }}" required>
            </div>
            <div class="sp-contact-form__field">
              <input type="text" name="contact[last_name]" id="contact-last-name" class="sp-contact-form__input" placeholder="{{ section.settings.last_name_label }}" required>
            </div>
          </div>

          {%- comment -%}--- Project Address ---{%- endcomment -%}
          <div class="sp-contact-form__row">
            <div class="sp-contact-form__field">
              <input type="text" name="contact[project_address]" id="contact-project-address" class="sp-contact-form__input" placeholder="{{ section.settings.project_address_label }}" required>
            </div>
          </div>

          {%- comment -%}--- Property Type (radio dropdown) ---{%- endcomment -%}
          <div class="sp-contact-form__row">
            <div class="sp-contact-form__field">
              <div class="sp-contact-radio-dropdown">
                <button type="button" class="sp-contact-radio-dropdown__trigger" aria-expanded="false">
                  <span class="sp-contact-radio-dropdown__label">{{ section.settings.property_type_label }}</span>
                  <svg class="sp-contact-radio-dropdown__chevron" width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="sp-contact-radio-dropdown__popover" hidden>
                  <ul class="sp-contact-form__radio-group">
                    {%- assign property_types = 'House,Apartment,Townhouse,Villa,Commercial,Other' | split: ',' -%}
                    {%- for type in property_types -%}
                      <li>
                        <label class="sp-contact-form__radio-label">
                          <input type="radio" name="contact[property_type]" value="{{ type }}" required class="visually-hidden">
                          <span class="sp-contact-form__radio-circle"></span>
                          <span class="sp-contact-form__radio-text">{{ type }}</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            </div>
          </div>

          {%- comment -%}--- Approximate Square Footage ---{%- endcomment -%}
          <div class="sp-contact-form__row">
            <div class="sp-contact-form__field">
              <input type="text" name="contact[square_footage]" id="contact-square-footage" class="sp-contact-form__input" placeholder="{{ section.settings.square_footage_label }}" required>
            </div>
          </div>

          {%- comment -%}--- Architect ---{%- endcomment -%}
          <div class="sp-contact-form__row">
            <div class="sp-contact-form__field">
              <input type="text" name="contact[architect]" id="contact-architect" class="sp-contact-form__input" placeholder="{{ section.settings.architect_label }}" required>
            </div>
          </div>

          {%- comment -%}--- Row: Estimated Timeline / Estimated Budget ---{%- endcomment -%}
          <div class="sp-contact-form__row sp-contact-form__row--half">
            <div class="sp-contact-form__field">
              <input type="text" name="contact[timeline]" id="contact-timeline" class="sp-contact-form__input" placeholder="{{ section.settings.timeline_label }}" required>
            </div>
            <div class="sp-contact-form__field">
              <input type="text" name="contact[budget]" id="contact-budget" class="sp-contact-form__input" placeholder="{{ section.settings.budget_label }}" required>
            </div>
          </div>

          {%- comment -%}--- Other Key Information ---{%- endcomment -%}
          <div class="sp-contact-form__row">
            <div class="sp-contact-form__field">
              <input type="text" name="contact[other_info]" id="contact-other-info" class="sp-contact-form__input" placeholder="{{ section.settings.other_info_label }}" required>
            </div>
          </div>

          {%- comment -%}--- How Did You Hear About Us (radio dropdown) ---{%- endcomment -%}
          <div class="sp-contact-form__row">
            <div class="sp-contact-form__field">
              <div class="sp-contact-radio-dropdown">
                <button type="button" class="sp-contact-radio-dropdown__trigger" aria-expanded="false">
                  <span class="sp-contact-radio-dropdown__label">{{ section.settings.referral_label }}</span>
                  <svg class="sp-contact-radio-dropdown__chevron" width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="sp-contact-radio-dropdown__popover" hidden>
                  <ul class="sp-contact-form__radio-group">
                    {%- assign referral_sources = 'Google,Instagram,Word of mouth,Press,Referral,Other' | split: ',' -%}
                    {%- for source in referral_sources -%}
                      <li>
                        <label class="sp-contact-form__radio-label">
                          <input type="radio" name="contact[referral_source]" value="{{ source }}" required class="visually-hidden">
                          <span class="sp-contact-form__radio-circle"></span>
                          <span class="sp-contact-form__radio-text">{{ source }}</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            </div>
          </div>

          {%- comment -%}--- Email (hidden visually but required by Shopify contact form) ---{%- endcomment -%}
          <div class="sp-contact-form__row">
            <div class="sp-contact-form__field">
              <input type="email" name="contact[email]" id="contact-email" class="sp-contact-form__input" placeholder="{{ section.settings.email_label }}" required>
            </div>
          </div>

          {%- comment -%}--- Submit ---{%- endcomment -%}
          <div class="sp-contact-form__row sp-contact-form__row--submit">
            <button type="submit" class="button button--outline sp-contact-form__submit">{{ section.settings.submit_label }}</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    document.addEventListener('click', function(e) {
      var trigger = e.target.closest('.sp-contact-radio-dropdown__trigger');
      if (trigger) {
        e.preventDefault();
        var dropdown = trigger.closest('.sp-contact-radio-dropdown');
        var popover = dropdown.querySelector('.sp-contact-radio-dropdown__popover');
        var isOpen = trigger.getAttribute('aria-expanded') === 'true';
        document.querySelectorAll('.sp-contact-radio-dropdown__trigger[aria-expanded="true"]').forEach(function(t) {
          if (t !== trigger) {
            t.setAttribute('aria-expanded', 'false');
            t.closest('.sp-contact-radio-dropdown').querySelector('.sp-contact-radio-dropdown__popover').hidden = true;
          }
        });
        trigger.setAttribute('aria-expanded', String(!isOpen));
        popover.hidden = isOpen;
        return;
      }
      if (!e.target.closest('.sp-contact-radio-dropdown')) {
        document.querySelectorAll('.sp-contact-radio-dropdown__trigger[aria-expanded="true"]').forEach(function(t) {
          t.setAttribute('aria-expanded', 'false');
          t.closest('.sp-contact-radio-dropdown').querySelector('.sp-contact-radio-dropdown__popover').hidden = true;
        });
      }
    });

    document.addEventListener('change', function(e) {
      var radio = e.target;
      if (radio.type !== 'radio' || !radio.closest('.sp-contact-radio-dropdown')) return;
      var dropdown = radio.closest('.sp-contact-radio-dropdown');
      var trigger = dropdown.querySelector('.sp-contact-radio-dropdown__trigger');
      var label = trigger.querySelector('.sp-contact-radio-dropdown__label');
      label.textContent = radio.value;
      trigger.classList.add('sp-contact-radio-dropdown__trigger--selected');
    });
  })();
</script>

{% schema %}
{
  "name": "SP Contact Form",
  "class": "shopify-section--sp-contact-form",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "allow_transparent_header",
      "label": "t:global.section.allow_transparent_header",
      "info": "t:global.section.allow_transparent_header_info",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Let's discuss your project"
    },
    {
      "type": "header",
      "content": "Field labels"
    },
    {
      "type": "text",
      "id": "first_name_label",
      "label": "First name",
      "default": "First name*"
    },
    {
      "type": "text",
      "id": "last_name_label",
      "label": "Last name",
      "default": "Last name*"
    },
    {
      "type": "text",
      "id": "project_address_label",
      "label": "Project address",
      "default": "Project address*"
    },
    {
      "type": "text",
      "id": "property_type_label",
      "label": "Property type",
      "default": "Property type*"
    },
    {
      "type": "text",
      "id": "square_footage_label",
      "label": "Square footage",
      "default": "Approximate square footage*"
    },
    {
      "type": "text",
      "id": "architect_label",
      "label": "Architect",
      "default": "Have you appointed an architect? If yes, please provide name*"
    },
    {
      "type": "text",
      "id": "timeline_label",
      "label": "Timeline",
      "default": "Estimated timeline*"
    },
    {
      "type": "text",
      "id": "budget_label",
      "label": "Budget",
      "default": "Estimated budget*"
    },
    {
      "type": "text",
      "id": "other_info_label",
      "label": "Other info",
      "default": "Other key information on project*"
    },
    {
      "type": "text",
      "id": "referral_label",
      "label": "Referral source",
      "default": "How did you hear about us?*"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email address",
      "default": "Email address*"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button text",
      "default": "Submit form"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for your enquiry. We will be in touch shortly."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor link ID"
    }
  ],
  "presets": [
    {
      "name": "SP Contact Form"
    }
  ]
}
{% endschema %}
