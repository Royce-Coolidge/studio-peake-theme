<x-modal id="enquiry-modal"
  class="modal enquiry-modal color-scheme color-scheme--{{ section.settings.color_scheme.id }}"
  handle-editor-events
  aria-label="Product Enquiry">
  <div class="enquiry-modal__layout">
    <div class="enquiry-modal__image-panel" aria-hidden="true">
      {%- if section.settings.fallback_image != blank -%}
        {{- section.settings.fallback_image | image_url: width: section.settings.fallback_image.width
            | image_tag: class: 'enquiry-modal__image',
                         sizes: '40vw',
                         widths: '400,600,800,1000,1200,1600',
                         loading: 'eager' -}}
      {%- else -%}
        {{- 'lifestyle-1' | placeholder_svg_tag: 'enquiry-modal__image placeholder' -}}
      {%- endif -%}
    </div>
    <div class="enquiry-modal__form-panel">
      <dialog-close-button class="contents">
        <button type="button" class="enquiry-modal__close tap-area"
                aria-label="{{ 'general.accessibility.close' | t }}">
          {%- render 'icon' with 'close' -%}
        </button>
      </dialog-close-button>
      <div class="enquiry-modal__form-content">
        {%- form 'contact', class: 'form' -%}
          <input type="hidden" name="contact[Product]" value="">
            <div class="enquiry-modal__success" {% unless form.posted_successfully? %}hidden{% endunless %}>
              <p class="h2">WE'LL BE IN TOUCH</p>
              <p class="text-subdued">Thank you for your enquiry. We'll get back to you shortly.</p>
            </div>

            <div class="enquiry-modal__fields" {% if form.posted_successfully? %}hidden{% endif %}>
            {%- if form.errors -%}
              {%- capture error_content -%}{{ form.errors.translated_fields[form.errors.first] | capitalize }} {{ form.errors.messages[form.errors.first] }}{%- endcapture -%}
              {%- render 'banner', status: 'error', content: error_content -%}
            {%- endif -%}

            <p class="h2 enquiry-modal__product-heading"></p>

            {%- assign has_first_name = false -%}
            {%- assign has_last_name = false -%}
            {%- assign has_country = false -%}
            {%- assign has_postcode = false -%}
            {%- assign rendered_first_name = false -%}
            {%- assign rendered_last_name = false -%}
            {%- assign rendered_country = false -%}
            {%- assign rendered_postcode = false -%}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'first_name' -%}{%- assign has_first_name = true -%}
                {%- when 'last_name' -%}{%- assign has_last_name = true -%}
                {%- when 'country' -%}{%- assign has_country = true -%}
                {%- when 'postcode' -%}{%- assign has_postcode = true -%}
              {%- endcase -%}
            {%- endfor -%}

            <div class="fieldset">
              {%- for block in section.blocks -%}
                {%- case block.type -%}

                  {%- when 'first_name' -%}
                    {%- unless rendered_first_name -%}
                      {%- if has_first_name and has_last_name -%}
                        <div class="fieldset-row" {{ block.shopify_attributes }}>
                          {%- render 'input', type: 'text', name: 'contact[first_name]', label: 'First Name', value: customer.first_name, autocomplete: 'given-name' -%}
                          {%- render 'input', type: 'text', name: 'contact[last_name]', label: 'Last Name', value: customer.last_name, autocomplete: 'family-name' -%}
                        </div>
                        {%- assign rendered_first_name = true -%}
                        {%- assign rendered_last_name = true -%}
                      {%- else -%}
                        <div {{ block.shopify_attributes }}>
                          {%- render 'input', type: 'text', name: 'contact[first_name]', label: 'First Name', value: customer.first_name, autocomplete: 'given-name' -%}
                        </div>
                        {%- assign rendered_first_name = true -%}
                      {%- endif -%}
                    {%- endunless -%}

                  {%- when 'last_name' -%}
                    {%- unless rendered_last_name -%}
                      {%- if has_first_name and has_last_name -%}
                        <div class="fieldset-row" {{ block.shopify_attributes }}>
                          {%- render 'input', type: 'text', name: 'contact[first_name]', label: 'First Name', value: customer.first_name, autocomplete: 'given-name' -%}
                          {%- render 'input', type: 'text', name: 'contact[last_name]', label: 'Last Name', value: customer.last_name, autocomplete: 'family-name' -%}
                        </div>
                        {%- assign rendered_first_name = true -%}
                        {%- assign rendered_last_name = true -%}
                      {%- else -%}
                        <div {{ block.shopify_attributes }}>
                          {%- render 'input', type: 'text', name: 'contact[last_name]', label: 'Last Name', value: customer.last_name, autocomplete: 'family-name' -%}
                        </div>
                        {%- assign rendered_last_name = true -%}
                      {%- endif -%}
                    {%- endunless -%}

                  {%- when 'email' -%}
                    <div {{ block.shopify_attributes }}>
                      {%- render 'input', type: 'email', name: 'contact[email]', label: 'Email Address', value: customer.email, autocomplete: 'email' -%}
                    </div>

                  {%- when 'company' -%}
                    <div {{ block.shopify_attributes }}>
                      {%- render 'input', type: 'text', name: 'contact[company]', label: 'Company Name', autocomplete: 'organization' -%}
                    </div>

                  {%- when 'phone' -%}
                    <div {{ block.shopify_attributes }}>
                      {%- render 'input', type: 'tel', name: 'contact[phone]', label: 'Phone Number', autocomplete: 'tel' -%}
                    </div>

                  {%- when 'address' -%}
                    <div {{ block.shopify_attributes }}>
                      {%- render 'input', type: 'text', name: 'contact[address]', label: 'Address', autocomplete: 'street-address' -%}
                    </div>

                  {%- when 'country' -%}
                    {%- unless rendered_country -%}
                      {%- if has_country and has_postcode -%}
                        <div class="fieldset-row" {{ block.shopify_attributes }}>
                          {%- render 'select', name: 'contact[country]', label: 'Country', options: all_country_option_tags, show_empty_value: true, autocomplete: 'country' -%}
                          {%- render 'input', type: 'text', name: 'contact[postcode]', label: 'Postcode', autocomplete: 'postal-code' -%}
                        </div>
                        {%- assign rendered_country = true -%}
                        {%- assign rendered_postcode = true -%}
                      {%- else -%}
                        <div {{ block.shopify_attributes }}>
                          {%- render 'select', name: 'contact[country]', label: 'Country', options: all_country_option_tags, show_empty_value: true, autocomplete: 'country' -%}
                        </div>
                        {%- assign rendered_country = true -%}
                      {%- endif -%}
                    {%- endunless -%}

                  {%- when 'postcode' -%}
                    {%- unless rendered_postcode -%}
                      {%- if has_country and has_postcode -%}
                        <div class="fieldset-row" {{ block.shopify_attributes }}>
                          {%- render 'select', name: 'contact[country]', label: 'Country', options: all_country_option_tags, show_empty_value: true, autocomplete: 'country' -%}
                          {%- render 'input', type: 'text', name: 'contact[postcode]', label: 'Postcode', autocomplete: 'postal-code' -%}
                        </div>
                        {%- assign rendered_country = true -%}
                        {%- assign rendered_postcode = true -%}
                      {%- else -%}
                        <div {{ block.shopify_attributes }}>
                          {%- render 'input', type: 'text', name: 'contact[postcode]', label: 'Postcode', autocomplete: 'postal-code' -%}
                        </div>
                        {%- assign rendered_postcode = true -%}
                      {%- endif -%}
                    {%- endunless -%}

                  {%- when 'notes' -%}
                    <div {{ block.shopify_attributes }}>
                      {%- render 'input', name: 'contact[body]', label: 'Add Notes', multiline: 4 -%}
                    </div>

                  {%- when 'marketing' -%}
                    <div class="enquiry-modal__marketing" {{ block.shopify_attributes }}>
                      {%- capture marketing_label -%}
                        <span class="enquiry-modal__marketing-heading">I want to receive email marketing</span>
                        <span class="enquiry-modal__marketing-disclaimer">{{ block.settings.disclaimer_text }}</span>
                      {%- endcapture -%}
                      {%- render 'checkbox', name: 'contact[marketing]', value: 'yes', label: marketing_label -%}
                    </div>

                {%- endcase -%}
              {%- endfor -%}
            </div>

            {%- render 'button', content: 'Submit Enquiry', type: 'submit', style: 'outline' -%}
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</x-modal>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('enquiry-modal');
    if (!modal) return;

    // Product data bridge — read from main-product section data attributes
    const productSource = document.querySelector('[data-enquiry-product-title]');
    const productTitle = productSource?.dataset.enquiryProductTitle || '';
    const imageUrl = productSource?.dataset.enquiryImageUrl || '';

    // Update heading
    const heading = modal.querySelector('.enquiry-modal__product-heading');
    if (heading && productTitle) heading.textContent = productTitle;

    // Update hidden field
    const hiddenField = modal.querySelector('input[name="contact[Product]"]');
    if (hiddenField && productTitle) hiddenField.value = productTitle;

    // Update image panel (replace fallback/placeholder with product image)
    if (imageUrl) {
      const imagePanel = modal.querySelector('.enquiry-modal__image-panel');
      if (imagePanel) {
        const img = document.createElement('img');
        img.className = 'enquiry-modal__image';
        img.src = imageUrl;
        img.alt = productTitle;
        img.loading = 'eager';
        imagePanel.replaceChildren(img);
      }
    }

    modal.addEventListener('dialog:after-hide', () => {
      const success = modal.querySelector('.enquiry-modal__success');
      const fields = modal.querySelector('.enquiry-modal__fields');
      const form = modal.querySelector('form');
      if (success) success.hidden = true;
      if (fields) fields.hidden = false;
      if (form) form.reset();
    });

    if (!modal.querySelector('.enquiry-modal__success').hidden || modal.querySelector('.banner--error')) {
      modal.show();
    }
  });
</script>

{% schema %}
{
  "name": "Product Enquiry Modal",
  "class": "shopify-section--enquiry-modal",
  "enabled_on": {
    "groups": ["custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Fallback image",
      "info": "Shown when no product image is available"
    }
  ],
  "blocks": [
    {
      "type": "first_name",
      "name": "First Name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "last_name",
      "name": "Last Name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "email",
      "name": "Email Address",
      "limit": 1,
      "settings": []
    },
    {
      "type": "company",
      "name": "Company Name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "phone",
      "name": "Phone Number",
      "limit": 1,
      "settings": []
    },
    {
      "type": "address",
      "name": "Address",
      "limit": 1,
      "settings": []
    },
    {
      "type": "country",
      "name": "Country",
      "limit": 1,
      "settings": []
    },
    {
      "type": "postcode",
      "name": "Postcode",
      "limit": 1,
      "settings": []
    },
    {
      "type": "notes",
      "name": "Notes",
      "limit": 1,
      "settings": []
    },
    {
      "type": "marketing",
      "name": "Marketing Opt-in",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "disclaimer_text",
          "label": "Disclaimer text",
          "default": "<p>I agree to receive marketing communications from Studio Peake.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
