<style>
  #shopify-section-{{ section.id }} x-modal#enquiry-modal::part(overlay) {
    background: rgba(0, 0, 0, 0.5);
  }

  #shopify-section-{{ section.id }} x-modal#enquiry-modal::part(content) {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    border-radius: 0;
    display: flex;
  }

  #shopify-section-{{ section.id }} x-modal#enquiry-modal::part(body) {
    padding: 0;
    flex: 1;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} x-modal#enquiry-modal::part(close-button) {
    display: none;
  }

  #shopify-section-{{ section.id }} x-modal#enquiry-modal::part(header) {
    display: none;
  }

  #shopify-section-{{ section.id }} .enquiry-modal__layout {
    display: grid;
    grid-template-columns: 40fr 60fr;
    height: 100%;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .enquiry-modal__form-panel {
    position: relative;
    overflow-y: auto;
  }

  #shopify-section-{{ section.id }} .enquiry-modal__close {
    position: absolute;
    top: var(--spacing-5, 20px);
    right: var(--spacing-5, 20px);
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .enquiry-modal__layout {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .enquiry-modal__image-panel {
      display: none;
    }
  }
</style>

<x-modal id="enquiry-modal"
  class="enquiry-modal color-scheme color-scheme--{{ section.settings.color_scheme.id }}"
  handle-editor-events
  aria-label="Product Enquiry">
  <div class="enquiry-modal__layout">
    <div class="enquiry-modal__image-panel" aria-hidden="true">
      {%- comment -%} Phase 3: product image {%- endcomment -%}
    </div>
    <div class="enquiry-modal__form-panel">
      <dialog-close-button class="contents">
        <button type="button" class="enquiry-modal__close tap-area"
                aria-label="{{ 'general.accessibility.close' | t }}">
          {%- render 'icon' with 'close' -%}
        </button>
      </dialog-close-button>
      {%- comment -%} Phase 2: contact form {%- endcomment -%}
    </div>
  </div>
</x-modal>

{% schema %}
{
  "name": "Product Enquiry Modal",
  "class": "shopify-section--enquiry-modal",
  "enabled_on": {
    "groups": ["custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
