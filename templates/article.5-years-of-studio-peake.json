        "image_with_text_n7hUh6": {
          "type": "image_with_text",
          "settings": {
            "title": "",
            "heading_tag": "h3",
            "content": "<p>Last night we celebrated five years of Studio Peake, and it was one of those evenings that felt genuinely special—full of familiar faces, brilliant conversation, and a room filled with the people who have helped shape the studio into what it is today.</p><p>We hosted a party with our suppliers, supporters and friends, and it was such a joy to have everyone together in one place. It felt like a rare moment to pause, reflect, and properly appreciate just how much has gone into building the studio over the last five years.</p>",
            "link_url": "",
            "link_text": "",
            "compact_text": false
          }
        }
