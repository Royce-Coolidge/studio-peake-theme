{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
PROJECT CARD COMPONENT
----------------------------------------------------------------------------------------------------------------------

Renders a project metaobject as a card. Identical markup to product-card for CSS reuse,
but reads from metaobject fields instead of product fields.

Field mapping:
  product.url                    → project.system.url
  product.featured_media         → project.sketch_image.value
  product.title                  → project.title.value (fallback: project.system.display_name)
  product.vendor                 → (not used)
  product.media.size > 1         → (no secondary image)

********************************************
Supported variables
********************************************

* project: the project metaobject to render
* reveal: if set to true, the card will be revealed on scroll through animation
* position: the position of the card in the list. Used for eager/lazy loading logic
* hide_product_information: if set to true, all content (title) is not rendered
{%- endcomment -%}

{%- liquid
  assign main_media_loading_strategy = nil

  if section.index > 3 or position > 3
    assign main_media_loading_strategy = 'lazy'
  endif

  assign text_class = ''
  if settings.product_card_text_font == 'heading'
    assign text_class = 'h6'
  endif

  assign project_image = project.hero_image.value
  assign project_title = project.title.value | default: project.system.display_name
  assign project_url = project.system.url
-%}

<product-card class="product-card" {% if reveal %}reveal-on-scroll="true"{% endif %}>
  {%- comment -%}
  --------------------------------------------------------------------------------------------------------------------
  PROJECT MEDIA
  --------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  {%- if project_image != blank -%}
    <div class="product-card__figure">
      <a href="{{ project_url }}" class="product-card__media" draggable="false">
        {%- capture main_image_classes -%}product-card__image product-card__image--primary {% if settings.product_image_aspect_ratio contains 'crop' %}object-cover{% endif %} aspect-{{ settings.product_image_aspect_ratio | split: '_' | first }}{%- endcapture -%}
        {{- project_image | image_url: width: project_image.width | image_tag: loading: main_media_loading_strategy, widths: '200,300,400,500,600,700,800,1000,1200,1400,1600,1800', draggable: 'false', class: main_image_classes -}}
      </a>
    </div>
  {%- endif -%}

  {%- comment -%}
  --------------------------------------------------------------------------------------------------------------------
  PROJECT INFO
  --------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  {%- unless hide_product_information -%}
    <div class="product-card__info empty:hidden">
      <div class="v-stack justify-items-center gap-2">
        <div class="v-stack justify-items-center gap-1">
          <a href="{{ project_url }}" class="product-title {% if text_class != blank %}{{ text_class }}{% endif %} {% if settings.product_title_max_lines > 0 %}line-clamp{% endif %}" {% if settings.product_title_max_lines > 0 %}style="--line-clamp-count: {{ settings.product_title_max_lines }}"{% endif %}>
            {{- project_title -}}
          </a>
        </div>
      </div>
    </div>
  {%- endunless -%}
</product-card>
