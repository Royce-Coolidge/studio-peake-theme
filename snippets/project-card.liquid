{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
PROJECT CARD COMPONENT
----------------------------------------------------------------------------------------------------------------------

Renders a project metaobject as a card. Mirrors product-card markup for CSS reuse.

********************************************
Supported variables
********************************************

* project: the project metaobject to render
* reveal: if set to true, the card will be revealed on scroll through animation
* position: the position of the card in the list. Used for eager/lazy loading logic
* hide_product_information: if set to true, all content (title, category) are not rendered, to create image-based grid
{%- endcomment -%}

{%- liquid
  assign main_media_loading_strategy = nil

  if section.index > 3 or position > 3
    assign main_media_loading_strategy = 'lazy'
  endif

  assign text_class = ''
  if settings.product_card_text_font == 'heading'
    assign text_class = 'h6'
  endif

  capture main_image_classes
    echo 'product-card__image product-card__image--primary'
    if settings.product_image_aspect_ratio contains 'crop'
      echo ' object-cover'
    endif
    echo ' aspect-' | append: settings.product_image_aspect_ratio | split: '_' | first
  endcapture
-%}

<product-card class="product-card" {% if reveal %}reveal-on-scroll="true"{% endif %}>
  {%- comment -%}
  --------------------------------------------------------------------------------------------------------------------
  PROJECT MEDIA
  --------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  <div class="product-card__figure">
    <a href="{{ project.system.url }}" class="product-card__media" draggable="false">
      {%- if project.featured_image != blank -%}
        {{- project.featured_image | image_url: width: project.featured_image.width | image_tag: loading: main_media_loading_strategy, widths: '200,300,400,500,600,700,800,1000,1200,1400,1600,1800', draggable: 'false', class: main_image_classes -}}
      {%- else -%}
        {{- 'image' | placeholder_svg_tag: main_image_classes | append: ' placeholder' -}}
      {%- endif -%}
    </a>
  </div>

  {%- comment -%}
  --------------------------------------------------------------------------------------------------------------------
  PROJECT INFO
  --------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  {%- unless hide_product_information -%}
    <div class="product-card__info empty:hidden">
      <div class="v-stack justify-items-center gap-2">
        {%- if project.category != blank and project.category.value != blank -%}
          {%- capture category_class -%}smallcaps {% if settings.product_card_text_font == 'heading' %}heading{% endif %}{%- endcapture -%}
          <span class="{{ category_class }}">{{ project.category.value.title }}</span>
        {%- endif -%}

        <div class="v-stack justify-items-center gap-1">
          <a href="{{ project.system.url }}" class="product-title {% if text_class != blank %}{{ text_class }}{% endif %} {% if settings.product_title_max_lines > 0 %}line-clamp{% endif %}" {% if settings.product_title_max_lines > 0 %}style="--line-clamp-count: {{ settings.product_title_max_lines }}"{% endif %}>
            {{- project.system.display_name -}}
          </a>
        </div>
      </div>
    </div>
  {%- endunless -%}
</product-card>
