{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
BLOG POST CARD COMPONENT
----------------------------------------------------------------------------------------------------------------------
Renders a single blog post as a 50/50 editorial split card — image left, coloured panel right.

********************************************
Supported parameters
********************************************
* article: the article to render. If no article is passed then a placeholder is generated
* blog: the blog the article belongs to (if any)
* show_category: if set to true, the first tag of the article is shown as a category
* show_date: if set to true, the publication date of the article will be visible
* show_excerpt: if set to true, it will show the excerpt first or truncated part of the main content if none is set
* show_read_more: if set to true, a read more link will be visible after the excerpt to redirect to the full blog post
* card_color_scheme: the color scheme applied to the info panel
* sizes: the sizes attribute to show for loading the images
* position: the position of the card in the list. If specified, the theme will eagerly load the first 3 cards images
{%- endcomment -%}

{%- liquid
  assign loading_strategy = nil
  if section.index > 3 or position > 3
    assign loading_strategy = 'lazy'
  endif

  assign article_color = article.metafields.custom.card_colour.value
  assign article_text_color = article.metafields.custom.text_color.value
  assign article_subheading = article.metafields.custom.subheading.value

  if card_color_scheme
    assign panel_scheme_hash = card_color_scheme.settings.background_gradient | default: card_color_scheme.settings.background | md5
  endif
-%}

<div class="blog-post-card group snap-center">
  <div class="blog-post-card__image-wrap">
    {%- if article -%}
      {%- if article.image != blank -%}
        <a href="{{ article.url }}">
          {{- article.image | image_url: width: article.image.width | image_tag: loading: loading_strategy, sizes: sizes, widths: '300,400,500,600,800,1000,1200,1400,1600,1800,2000', class: 'blog-post-card__image' -}}
        </a>
      {%- endif -%}
    {%- else -%}
      {{- 'image' | placeholder_svg_tag: 'blog-post-card__image placeholder placeholder--invert' -}}
    {%- endif -%}
  </div>

  {%- capture panel_style -%}
    {%- if article_color != blank %}background-color: {{ article_color }};{% endif -%}
    {%- if article_text_color != blank %} color: {{ article_text_color }};{% endif -%}
  {%- endcapture -%}

  {%- if article_color != blank -%}
    <div class="blog-post-card__info" style="{{ panel_style }}">
  {%- elsif card_color_scheme -%}
    <div class="blog-post-card__info color-scheme color-scheme--{{ card_color_scheme.id }} color-scheme--bg-{{ panel_scheme_hash }}" {% if article_text_color != blank %}style="color: {{ article_text_color }};"{% endif %}>
  {%- else -%}
    <div class="blog-post-card__info" {% if article_text_color != blank %}style="color: {{ article_text_color }};"{% endif %}>
  {%- endif -%}
    <div class="blog-post-card__info-top">
      {%- if article -%}
        <p class="blog-post-card__title h4">
          <a href="{{ article.url }}" class="reversed-link">{{ article.title }}</a>
        </p>
      {%- else -%}
        <p class="blog-post-card__title h4">{{- 'general.on_boarding.blog_post_title' | t -}}</p>
      {%- endif -%}

      {%- if article_subheading != blank -%}
        <p class="blog-post-card__category">{{ article_subheading }}</p>
      {%- elsif show_category and article.tags.size > 0 -%}
        <p class="blog-post-card__category">
          <a href="{{ blog.url }}/tagged/{{ article.tags.first | handle }}" class="link-faded">{{ article.tags | first }}</a>
        </p>
      {%- endif -%}

      {%- if show_date -%}
        <span class="blog-post-card__date text-subdued">{{- article.published_at | time_tag: format: 'abbreviated_date' -}}</span>
      {%- endif -%}
    </div>

    <div class="blog-post-card__info-bottom">
      {%- if show_excerpt -%}
        {%- if article -%}
          {%- unless article.excerpt_or_content == blank -%}
            <p class="blog-post-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 200 }}</p>
          {%- endunless -%}
        {%- else -%}
          <p class="blog-post-card__excerpt">{{ 'general.on_boarding.blog_post_excerpt' | t }}</p>
        {%- endif -%}
      {%- endif -%}

      {%- if show_read_more -%}
        {%- assign sp_btn_text = article.metafields.custom.button_text.value | default: 'Read more' -%}
        {%- assign sp_btn_link = article.metafields.custom.button_link.value | default: article.url | default: '#' -%}
        <a href="{{ sp_btn_link }}" class="blog-post-card__read-more link">{{ sp_btn_text }}</a>
      {%- endif -%}
    </div>
  </div>
</div>